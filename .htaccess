<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes

    RewriteEngine On

    RewriteRule ^(\.env|\.env\..*|composer\.(json|lock)|package\.json|package-lock\.json|vite\.config\.js|phpunit\.xml|artisan)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|_legacy_native_php_.*)(/|$) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
